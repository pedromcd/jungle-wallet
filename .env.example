# Copy to .env only if you want to override docker-compose defaults.
# Every value below is read by the service (see internal/platform/config.go).
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://wallet:wallet@postgres:5432/wallet?sslmode=disable
DB_MAX_CONNS=20

AWS_REGION=us-east-1
SQS_ENDPOINT=http://localstack:4566
QUEUE_TRANSACTIONS=wager-transactions.fifo
QUEUE_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
QUEUE_EVENTS=wager-events.fifo

# OIDC_ISSUER must equal the "iss" claim of the tokens (the public Keycloak URL);
# OIDC_JWKS_URL is where THIS container reaches Keycloak.
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_JWKS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
ROLE_PROVIDER=provider
ROLE_INTERNAL=wallet-internal

CONSUMER_ENABLED=true
CONSUMER_CONCURRENCY=2
VISIBILITY_TIMEOUT=60s
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH=25
OUTBOX_LEASE=30s
PENDING_ENABLED=true
PENDING_POLL_INTERVAL=1s
PENDING_MAX_ATTEMPTS=8
PENDING_TTL=15m
PENDING_BACKOFF_BASE=2s
PENDING_BACKOFF_MAX=5m
SHUTDOWN_TIMEOUT=25s
